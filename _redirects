# =========================
# RS-Expert — Cloudflare Pages (_redirects)
# Variant 1: Pretty URLs ON, canonical without .html
# RU routes served via /ru/* (same HTML, language via JS)
# =========================

# --- Canonicalize FI .html -> clean (301) ---
/index.html            /                 301
/services.html         /services          301
/gallery.html          /gallery           301
/hinnasto.html         /hinnasto          301
/referenssit.html      /referenssit       301
/documents.html        /documents         301
/tarjouspyynto.html    /tarjouspyynto     301
/contact.html          /contact           301

# --- Canonicalize RU .html -> clean (301) ---
/ru/index.html         /ru/              301
/ru/services.html      /ru/services       301
/ru/gallery.html       /ru/gallery        301
/ru/hinnasto.html      /ru/hinnasto       301
/ru/referenssit.html   /ru/referenssit    301
/ru/documents.html     /ru/documents      301
/ru/tarjouspyynto.html /ru/tarjouspyynto  301
/ru/contact.html       /ru/contact        301

# --- Normalize /ru -> /ru/ (301) ---
/ru                   /ru/               301

# --- Serve RU clean URLs (200) ---
# IMPORTANT: rewrite to CLEAN paths (no .html) to avoid redirect loops
/ru/                  /                  200
/ru/services           /services          200
/ru/services/          /services          200
/ru/gallery            /gallery           200
/ru/gallery/           /gallery           200
/ru/hinnasto           /hinnasto          200
/ru/hinnasto/          /hinnasto          200
/ru/referenssit        /referenssit       200
/ru/referenssit/       /referenssit       200
/ru/documents          /documents         200
/ru/documents/         /documents         200
/ru/tarjouspyynto      /tarjouspyynto     200
/ru/tarjouspyynto/     /tarjouspyynto     200
/ru/contact            /contact           200
/ru/contact/           /contact           200
