# =========================
# RS-Expert — Cloudflare Pages (_redirects)
# Variant 1: Pretty URLs ON, canonical without .html
# RU is served via /ru/* (no physical /ru/*.html files)
# =========================

# --- FI: canonicalize .html -> clean (301) ---
/index.html            /                 301
/services.html         /services          301
/gallery.html          /gallery           301
/hinnasto.html         /hinnasto          301
/referenssit.html      /referenssit       301
/documents.html        /documents         301
/tarjouspyynto.html    /tarjouspyynto     301
/contact.html          /contact           301

# --- Normalize /ru -> /ru/ (301) ---
/ru                   /ru/               301

# --- RU: serve clean URLs (200) ---
/ru/                  /index.html        200
/ru/services          /services.html      200
/ru/services/         /services.html      200
/ru/gallery           /gallery.html       200
/ru/gallery/          /gallery.html       200
/ru/hinnasto          /hinnasto.html      200
/ru/hinnasto/         /hinnasto.html      200
/ru/referenssit       /referenssit.html   200
/ru/referenssit/      /referenssit.html   200
/ru/documents         /documents.html     200
/ru/documents/        /documents.html     200
/ru/tarjouspyynto     /tarjouspyynto.html 200
/ru/tarjouspyynto/    /tarjouspyynto.html 200
/ru/contact           /contact.html       200
/ru/contact/          /contact.html       200
